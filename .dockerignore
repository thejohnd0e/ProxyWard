# Keep secrets, state and host artifacts out of the build context.
.git
.gitignore
.env
.env.*
!.env.example

# Local state, databases and key files
data/
*.db
*.db-wal
*.db-shm
secrets.key
*.tar.gz

# Host-installed dependencies and build output (rebuilt inside the image)
web/node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/e2e-screenshots/
web/e2e/.auth/
internal/webui/dist/*
!internal/webui/dist/.gitkeep
.e2e/

# Editor, OS and agent files
.vscode/
.idea/
.omo/
.DS_Store
Thumbs.db
docs/
*.md
