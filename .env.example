# Everything here is optional: ProxyWard starts without a .env file.
# This file holds no secrets; the administrator password is set with a command
# (see docs/operations.md), never in a file.

# Host port for the web interface. ./start.sh chooses a free one and writes it here.
# Set it yourself for a specific port. The port inside the container stays 8080.
# PORT=8080

# Which address of this machine the interface listens on.
#   0.0.0.0     every address: reachable from other devices (default)
#   127.0.0.1   only this machine
#   192.168.0.10  one specific address (use your own LAN address)
# If the machine has a public internet address, do not leave this at 0.0.0.0:
# Docker publishes ports around the host firewall.
# BIND_ADDRESS=0.0.0.0

# Set to true only when the interface is served over HTTPS.
# SESSION_SECURE=false
