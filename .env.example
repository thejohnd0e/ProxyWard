# Copy to .env and edit. This file holds no secrets: the administrator password
# is set with a command (see docs/operations.md), never in a file.

# Required: the host's LAN address that the web interface is published on.
LAN_IP=192.168.0.10

# Host port for the web interface. Change it if 8080 is already in use on this host
# (check with: ss -ltn | grep :8080). The port inside the container stays 8080.
PORT=8080

# Optional: set to true only when the interface is served over HTTPS.
# SESSION_SECURE=false
